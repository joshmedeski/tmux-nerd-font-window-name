#!/usr/bin/env bash

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-nerd-font-window-name"
CACHE_FILE="$CACHE_DIR/config.sh"
mkdir -p "$CACHE_DIR"

CACHE_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$CACHE_CONFIG_DIR/lib.sh"

emit_config_vars() {
  local user_config="$1" key val var
  while IFS=$'\t' read -r key val; do
    var="CFG_$(printf '%s' "$key" | tr 'a-z-' 'A-Z_')"
    printf '%s=%s\n' "$var" "$(shquote "$val")"
  done < <(merged_section_pairs config "$user_config")
}

emit_icons() {
  local user_config="$1" key val
  echo 'icon_for() {'
  echo '  case "$1" in'
  while IFS=$'\t' read -r key val; do
    printf '    %s) printf %%s\\\\n %s ;;\n' "$(shquote "$key")" "$(shquote "$val")"
  done < <(merged_section_pairs icons "$user_config")
  echo "    *) printf '%s\n' null ;;"
  echo '  esac'
  echo '}'
}

emit_regex_arrays() {
  local section="$1" user_config="$2" prefix="$3" key val
  local patterns="" values=""
  while IFS=$'\t' read -r key val; do
    patterns+=" $(shquote "$key")"
    values+=" $(shquote "$val")"
  done < <(yaml_section_pairs "$section" "$user_config")
  printf '%s_PATTERNS=(%s)\n' "$prefix" "$patterns"
  printf '%s_VALUES=(%s)\n'   "$prefix" "$values"
}

# Reset any previously loaded cache state, then load the cache file.
load_cache() {
  local v
  for v in $(compgen -v CFG_) $(compgen -v REGEX_); do unset "$v"; done
  unset -f icon_for 2>/dev/null
  unset CACHE_SOURCE_CONFIG
  source "$CACHE_FILE" 2>/dev/null
}

generate_cache() {
  local user_config="$1"
  {
    echo "# Generated by tmux-nerd-font-window-name plugin"
    printf "# Source config: %s\n" "$user_config"
    printf 'CACHE_SOURCE_CONFIG=%s\n' "$(shquote "$user_config")"
    emit_config_vars "$user_config"
    emit_icons "$user_config"
    emit_regex_arrays names-regex "$user_config" REGEX_NAMES
    emit_regex_arrays icons-regex "$user_config" REGEX_ICONS
  } > "$CACHE_FILE.tmp" && mv "$CACHE_FILE.tmp" "$CACHE_FILE"
}
